# 飞书自建应用凭证。
# 生产部署：在 EdgeOne 控制台「环境变量」中配置以下变量（免费），切勿提交真实值。
# 本地调试：可填入 functions/api/_env.js（已被 gitignore）。
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret
# 多维表格 base 的 app_token
FEISHU_APP_TOKEN=your_base_app_token
# 题库表 table_id
FEISHU_Q_TABLE=your_questions_table_id
# 成绩表 table_id
FEISHU_S_TABLE=your_scores_table_id
